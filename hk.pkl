# Local CI gate (hk v2, mise-pinned hk 2.4.0): hook-scoped steps mirror CI path
# filters. `hk.pkl` amends the pinned Config schema; Builtins stay on the same
# pin (see the `amends`/`import` URLs, kept in parity with the `hk` mise pin).
#
# Scope table (mirrors CI path filters):
#   flux/infra/** + tenants/infra.yaml + flux/scripts/** -> validate-infra
#   flux/apps/** + tenants/apps.yaml + flux/scripts/** -> validate-apps
#   flux/fleet/** -> validate-fleet + tofu (fleet validate has 2 jobs)
#   scripts/** + talos/** + projects/*/ci/** + flux/scripts/**
#     + .github/workflows/** -> shellcheck + yamllint + ansible
#   projects/<go-svc>/**                     -> go-fast (pre-commit) / go-full (pre-push)
#   projects/helm-<name>/**                  -> helm-verify-<name>
#
# Hook split: pre-commit = fast gates (seconds, commit-blocking); pre-push =
# slow whole-scope gates (tofu, full go, talosctl pin). Slow suites (go test
# -race, golangci-lint, govulncheck) stay at pre-push; only the offline subset
# (vet + gofmt + tidy -diff + build) runs at pre-commit.
# Network note: flux validate.sh downloads pinned CRD schemas and fetch-time
# chart verify.sh runs fetch --check against upstream URLs, so those
# pre-commit steps need GitHub network like CI does — dev machines normally
# have it; a network failure there means "retry with network", not "skip".
# Publishing (push/release/sign), image-update bots, and scheduled check-PR
# workflows never gate commits or pushes — they run in CI only. Nothing here
# touches a live cluster; day-2 --check --diff stays a manual hook (needs live
# pass-cli + cluster) via `hk run manual-day2`.
#
# Toolchain: every step resolves through the mise environment (HK_MISE=1 in
# mise.toml; mise.toml pins: hk 2.4.0, shellcheck 0.11.0, yamllint 1.37.1,
# ansible-core 2.21.4, yq 4.53.3, kubeconform 0.8.0, kustomize 5.8.1,
# go 1.26.7, golangci-lint 2.13.2, govulncheck 1.8.0, helm 4.3.0,
# tofu 1.12.6). Run with mise active (`mise trust` once per checkout).
# Hooks auto-install on directory entry (enter hook in mise.toml).
amends "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Builtins.pkl"

min_hk_version = "2.4.0"

// Files this change set owns for whitespace/EOF hygiene: repo-wide --all runs
// would otherwise rewrite pre-existing missing-EOF files (e.g. in .agents/,
// .vscode/) outside the task scope.
local owned = List(
  ".github/workflows/*.yml",
  ".github/workflows/*.yaml",
  "talos/**",
  "scripts/**",
  "flux/**",
  "projects/**",
  "AGENTS.md",
  "README.md",
  "hk.pkl",
  ".yamllint"
)

local ansibleScope = List(
  "talos/**",
  "scripts/**",
  "projects/*/ci/**",
  "flux/scripts/**",
  ".github/workflows/**"
)

local fast = new Mapping<String, Step> {
  // Secret strays: hard fail on build artifacts that must never be committed
  // (templates/placeholders only). No glob: checks every selected file.
  ["no-artifacts"] {
    check = "scripts/hooks/no-artifacts.sh {{files}}"
  }
  // Fast meta hygiene (always eligible; staged files only).
  ["trailing-whitespace"] = (Builtins.trailing_whitespace) {
    glob = owned
  }
  ["end-of-file-fixer"] = (Builtins.newlines) {
    glob = owned
  }
  // check-yaml rejects multi-doc manifests; yamllint (same scope, document
  // aware) is the YAML authority for owned paths, so this step only covers
  // the always-single-doc ones. Stage 1 rejects unparsable YAML; stage 2
  // rejects any doc past index 0 (yq -e is any-match, so the positive test
  // is inverted).
  ["check-yaml"] {
    glob = List(
      ".github/workflows/*.yml",
      ".github/workflows/*.yaml",
      "scripts/*.yml",
      "scripts/*.yaml",
      "projects/helm-*/Chart.yaml",
      "projects/helm-*/values.yaml",
      ".yamllint"
    )
    exclude = ".agents/**"
    check = "yq -e '.' {{files}} >/dev/null && ! yq -e ea 'select(document_index > 0)' {{files}} >/dev/null 2>&1"
  }
  ["check-added-large-files"] = (Builtins.check_added_large_files) {
    check = "hk util check-added-large-files --maxkb=200 {{files}}"
  }
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["check-executables-have-shebangs"] = Builtins.check_executables_have_shebangs
  // Shell + YAML lint (lint-shell-ansible.yaml shell/yaml jobs). Custom step
  // (not the shellcheck builtin) to keep prek's check-only behavior: the
  // builtin's check_diff would auto-apply fixes at pre-commit.
  ["shellcheck"] {
    glob = List("scripts/**", "talos/**", "flux/scripts/**", "projects/*/ci/**")
    types = List("shell")
    exclude = List(".agents/**", "**/.terraform/**")
    check = "shellcheck --severity=warning {{files}}"
  }
  ["yamllint"] = (Builtins.yamllint) {
    glob = List(".github/workflows/**", "talos/**", "scripts/**", "flux/scripts/**", "projects/helm-rclone/ci/**")
    types = List("yaml")
    check = "yamllint -c .yamllint {{files}}"
  }
  ["ansible-syntax"] {
    glob = ansibleScope
    env {
      ["ANSIBLE_CONFIG"] = "talos/ansible/ansible.cfg"
    }
    check = "ansible-playbook --syntax-check talos/ansible/playbooks/day0.yml talos/ansible/playbooks/day1.yml talos/ansible/playbooks/day2.yml -i localhost, -e talos_cluster=acme-dev-bdo1-talos-apps-01"
  }
  ["ansible-lint"] {
    glob = ansibleScope
    env {
      ["ANSIBLE_CONFIG"] = "talos/ansible/ansible.cfg"
    }
    check = "ansible-lint talos/ansible/playbooks/ talos/ansible/roles/"
  }
  // Flux validation (flux-*-validate.yaml mirrors; no {{files}}: validate.sh
  // -d scopes whole dirs). Concurrent steps are CI-parity: the validate jobs
  // run concurrently in CI against disjoint schema sets.
  ["validate-infra"] {
    glob = List("flux/infra/**", "flux/fleet/tenants/infra.yaml", "flux/scripts/**")
    check = "flux/scripts/validate.sh -d flux/infra"
  }
  ["validate-apps"] {
    glob = List("flux/apps/**", "flux/fleet/tenants/apps.yaml", "flux/scripts/**")
    check = "flux/scripts/validate.sh -d flux/apps"
  }
  ["validate-fleet"] {
    glob = List("flux/fleet/**", "flux/scripts/**")
    check = "flux/scripts/validate.sh -d flux/fleet"
  }
  // Go services fast gate (CI test-leg mirror via scripts/hooks/go-gate.sh).
  ["go-fast-apprise-go-api"] {
    glob = "projects/apprise-go-api/**"
    check = "scripts/hooks/go-gate.sh fast projects/apprise-go-api"
  }
  ["go-fast-eso-proton-pass"] {
    glob = "projects/eso-proton-pass/**"
    check = "scripts/hooks/go-gate.sh fast projects/eso-proton-pass"
  }
  ["go-fast-external-dns-netbird"] {
    glob = "projects/external-dns-netbird/**"
    check = "scripts/hooks/go-gate.sh fast projects/external-dns-netbird"
  }
  // Helm charts (CI test-leg mirror: helm-<name>.yml verify step).
  ["helm-verify-rclone"] {
    glob = "projects/helm-rclone/**"
    check = "bash projects/helm-rclone/ci/verify.sh"
  }
  ["helm-verify-cosi"] {
    glob = "projects/helm-cosi/**"
    check = "bash projects/helm-cosi/ci/verify.sh"
  }
  ["helm-verify-gateway-api"] {
    glob = "projects/helm-gateway-api/**"
    check = "bash projects/helm-gateway-api/ci/verify.sh"
  }
  ["helm-verify-kubevirt"] {
    glob = "projects/helm-kubevirt/**"
    check = "bash projects/helm-kubevirt/ci/verify.sh"
  }
  ["helm-verify-multus"] {
    glob = "projects/helm-multus/**"
    check = "bash projects/helm-multus/ci/verify.sh"
  }
  ["helm-verify-otel-monitoring-crds"] {
    glob = "projects/helm-otel-monitoring-crds/**"
    check = "bash projects/helm-otel-monitoring-crds/ci/verify.sh"
  }
}

local slow = new Mapping<String, Step> {
  ["talosctl-pin"] {
    glob = ansibleScope
    check = "talosctl version --client"
  }
  ["tofu-fleet"] {
    glob = "flux/fleet/terraform/**"
    check = "scripts/hooks/tofu-gate.sh"
  }
  // Go services full gate (fast + test + lint + vuln, whole module).
  ["go-full-apprise-go-api"] {
    glob = "projects/apprise-go-api/**"
    check = "scripts/hooks/go-gate.sh full projects/apprise-go-api"
  }
  ["go-full-eso-proton-pass"] {
    glob = "projects/eso-proton-pass/**"
    check = "scripts/hooks/go-gate.sh full projects/eso-proton-pass"
  }
  ["go-full-external-dns-netbird"] {
    glob = "projects/external-dns-netbird/**"
    check = "scripts/hooks/go-gate.sh full projects/external-dns-netbird"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = fast
  }
  ["pre-push"] {
    steps = slow
  }
  // Manual-only: secret-bound day-2 dry run (needs live pass-cli + cluster);
  // never auto-runs. No glob: always runs under `hk run manual-day2`.
  ["manual-day2"] {
    steps {
      ["ansible-day2-check"] {
        check = "ansible-playbook talos/ansible/playbooks/day2.yml -i localhost, -e talos_cluster=acme-dev-bdo1-talos-apps-01 --check --diff"
      }
    }
  }
  ["check"] {
    steps {
      ...fast
      ...slow
    }
  }
  ["fix"] {
    fix = true
    steps = fast
  }
}
