# Template for acme-prd-bdo1-talos-apps-01 secrets (Talos v1.14).
# secrets.yml itself is GITIGNORED (see talos/.gitignore) — generate + render:
#   talosctl gen secrets -o secrets.yml   # cluster PKI bundle (never commit)
#   pass-cli inject --in-file secrets.yml.template --out-file ../../ansible/build/acme-prd-bdo1-talos-apps-01/registry-creds.yml
# Authenticate first: export PROTON_PASS_PERSONAL_ACCESS_TOKEN=pst_...
# Binary is `pass-cli` (not proton-pass-cli). Double-brace refs ONLY —
# bare pass:// URIs are ignored by `pass-cli inject`.
docker-username: "{{ pass://acme-prd-bdo1-talos-apps-01/talos/docker-username }}"
docker-password: "{{ pass://acme-prd-bdo1-talos-apps-01/talos/docker-password }}"
ghcr-username: "{{ pass://acme-prd-bdo1-talos-apps-01/talos/ghcr-username }}"
ghcr-password: "{{ pass://acme-prd-bdo1-talos-apps-01/talos/ghcr-password }}"
